{
  "name": "feinman",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered tool and MCP server that makes unfamiliar codebases understandable to humans. Built on foundational ideas and schemas from Understand-Anything (Egonex-AI) and Repomix.",
  "main": "dist/server/index.js",
  "bin": {
    "feynstart": "./bin/feynstart.js",
    "feinman": "./bin/feynstart.js"
  },
  "scripts": {
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "dev:web": "vite",
    "dev:server": "tsx src/server/index.ts",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "start": "node bin/feynstart.js",
    "feynstart": "node bin/feynstart.js",
    "mcp": "node dist/mcp/cli.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codebase-understanding",
    "architecture-graph",
    "developer-tools",
    "feynman-technique",
    "code-navigator",
    "ai-agent",
    "skills",
    "understand-anything"
  ],
  "author": "Feinman Open Source Contributors",
  "attribution": {
    "base": "https://github.com/Egonex-AI/Understand-Anything",
    "authors": "Egonex-AI & Contributors",
    "references": [
      "https://github.com/Egonex-AI/Understand-Anything",
      "https://github.com/yamadashy/repomix",
      "https://github.com/guymoyal/wikipilot",
      "https://github.com/Philipcyrus/RepoMind"
    ]
  },
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "glob": "^10.4.5",
    "ignore": "^5.3.2",
    "open": "^10.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "lucide-react": "^0.453.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
